# ── Connections ──
# Defaults target the Docker Compose services (postgres, redis) — this is what
# `docker compose up` uses. For NATIVE host development (node/npm on your
# machine, only postgres+redis in Docker), point these at localhost instead:
#   DATABASE_URL="postgresql://sdr:sdr@localhost:5433/sdr?schema=public"
#   REDIS_URL="redis://localhost:6379"
DATABASE_URL="postgresql://sdr:sdr@postgres:5432/sdr?schema=public"
# Optional: separate database for live-DB tests (else they skip gracefully).
# TEST_DATABASE_URL="postgresql://sdr:sdr@postgres:5432/sdr_test?schema=public"
REDIS_URL="redis://redis:6379"
AUTH_SECRET="change-me-in-production-min-32-chars"
ENCRYPTION_KEY="change-me-in-production-min-32-chars"
# ^ DEV-ONLY placeholders. Production refuses to boot with them (see instrumentation.ts).
# Generate real ones: python3 -c "import secrets; print(secrets.token_hex(32))"
NEXTAUTH_URL="http://localhost:3000"
SIGNUP_ENABLED="true"

# Demo account for local development (docker compose up).
# Creates demo@agent-sdr.local with a demo workspace, campaign, and sample leads.
# Set to "false" in production. See README Quickstart for credentials.
SEED_DEMO_USER="true"

# LLM (at least one; per-task routing lives in model_configs, env is fallback)
LLM_PROVIDER="openai" # openai|anthropic|deepseek|openrouter
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
# Optional OpenRouter headers (improves model ranking/attribution on their platform)
OPENROUTER_HTTP_REFERER=""
OPENROUTER_X_TITLE=""
LLM_DEFAULT_MODEL="gpt-4o-mini"
LLM_STRONG_MODEL="gpt-4o"

# Email (console = dry-run, the zero-key default; pick a real provider for production)
EMAIL_PROVIDER="console" # resend|sendgrid|postmark|ses|smtp|console
EMAIL_FALLBACK="sendgrid,postmark" # optional failover chain (transient errors only)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
POSTMARK_API_KEY=""
SES_REGION=""
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via standard AWS env
SMTP_URL="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="SDR <sdr@example.com>"
EMAIL_REPLY_TO=""
EMAIL_WEBHOOK_SECRET=""
# Optional provider-specific webhook signing secret (Svix format, e.g. Resend dashboard)
RESEND_WEBHOOK_SECRET=""

# Prospecting / enrichment (PROSPECT_PROVIDER=seed for dev; apollo|hunter|pdl live)
PROSPECT_PROVIDER="seed"
APOLLO_API_KEY=""
HUNTER_API_KEY=""
PDL_API_KEY=""
NEVERBOUNCE_API_KEY=""

# CRM / calendar (OAuth tokens; also storable per-workspace via connections API)
HUBSPOT_TOKEN=""
SALESFORCE_TOKEN=""
SALESFORCE_INSTANCE_URL=""
GOOGLE_CALENDAR_TOKEN=""
OUTLOOK_TOKEN=""

# Policy defaults
MAX_AGENT_STEPS="20"
MAX_TOOL_CALLS="30"
MAX_RUNTIME_MS="300000"
# Per-tool timeout (ms): a single hung provider call fails instead of eating the whole run
TOOL_TIMEOUT_MS="120000"
DAILY_SEND_LIMIT_DEFAULT="50"
APPROVAL_MODE_DEFAULT="assisted"
